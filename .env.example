# API Configuration
BASE_URL=https://your-dev-api-domain.com/api/v1
PROD_BASE_URL=https://your-prod-api-domain.com/api/v1

# Google Maps Configuration
# Warning: For Android and iOS, you must also set the key natively:
# - Android: android/local.properties -> MAPS_API_KEY=YOUR_KEY_HERE
# - iOS: Set GoogleMapsApiKey in Info.plist or provide in AppDelegate
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
